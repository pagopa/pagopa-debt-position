<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="SAMPLING_RATE" value="10"/>

        <springProperty name="ECS_SERVICE_VERSION" source="info.application.version"/>

        <appender name="ECS_JSON_SAMPLED" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="co.elastic.logging.logback.EcsEncoder">
                <serviceName>${SERVICE_NAME:-pagopa-debt-position}</serviceName>
                <serviceVersion>${ECS_SERVICE_VERSION}</serviceVersion>
                <serviceEnvironment>${ENV:-loc}</serviceEnvironment>
            </encoder>
            <filter class="it.gov.pagopa.debtposition.config.SamplingFilter">
                <rate>${SAMPLING_RATE}</rate>
                <maxBurst>50</maxBurst>
            </filter>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>DENY</onMatch>
                <onMismatch>NEUTRAL</onMismatch>
            </filter>
        </appender>

        <appender name="ECS_JSON_ERRORS" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="co.elastic.logging.logback.EcsEncoder">
                <serviceName>${SERVICE_NAME:-pagopa-debt-position}</serviceName>
                <serviceVersion>${ECS_SERVICE_VERSION}</serviceVersion>
                <serviceEnvironment>${ENV:-loc}</serviceEnvironment>
            </encoder>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
        </appender>

        <root level="INFO">
            <appender-ref ref="ECS_JSON_SAMPLED"/>
            <appender-ref ref="ECS_JSON_ERRORS"/>
        </root>

</configuration>
